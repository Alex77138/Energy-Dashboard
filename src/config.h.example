#pragma once

// ─── WiFi (credentials par défaut si NVS vide) ───────────────────────────────
// Copiez ce fichier en "config.h" et renseignez vos valeurs.
// Ces valeurs ne sont utilisées qu'au TOUT PREMIER démarrage si le NVS est vierge.
// Après configuration via l'interface web, les identifiants sont stockés en NVS.
#define WIFI_SSID   "VotreSSID"
#define WIFI_PASS   "VotreMotDePasse"

// ─── Rafraîchissement ────────────────────────────────────────────────────────
#define POLL_INTERVAL_MS  4000

// ─── Source réseau par défaut (Home Assistant) ───────────────────────────────
// Ces valeurs s'appliquent uniquement si le NVS est vierge (première utilisation).
// Configurer le jeton Bearer dans l'interface web (Profil HA → Sécurité → Jetons).
#define DEFAULT_GRID_DEVICE   9                    // GridDevice::HOME_ASSISTANT
#define DEFAULT_GRID_HOST     "192.168.x.x:8123"
#define DEFAULT_GRID_ENTITY   "sensor.votre_entite_puissance"

// ─── F1ATB (routeur — conservé pour compilation f1atb.cpp, non utilisé) ──────
#define F1ATB1_HOST          "192.168.x.x"
#define F1ATB1_NAME          "Routeur"
#define F1ATB1_URL_STATUS    "/ajax_data"
#define F1ATB1_URL_FORCE_ON  "/ajax_etatActions?Force=1&NumAction=0"
#define F1ATB1_URL_FORCE_OFF "/ajax_etatActions?Force=-1&NumAction=0"
#define F1ATB2_HOST          "192.168.x.x"
#define F1ATB2_NAME          "ECS 2"
#define F1ATB2_URL_STATUS    "/ajax_data"
#define F1ATB2_URL_FORCE_ON  "/ajax_etatActions?Force=1&NumAction=0"
#define F1ATB2_URL_FORCE_OFF "/ajax_etatActions?Force=-1&NumAction=0"
